# Application
APP_NAME=CiteTrail
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Optional OpenAI-compatible language model
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=gpt-4o-mini
LLM_TIMEOUT=60

# Search providers
SEARCH_API=duckduckgo
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
SEARXNG_URL=
SEARCH_RESULT_LIMIT=5
SEARCH_TIMEOUT=15

# Research workflow
MAX_TASKS=4
MAX_WEB_RESEARCH_LOOPS=1
WORKSPACE_DIR=workspace
