# Application
APP_NAME=CiteTrail
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Optional OpenAI-compatible language model.
# Point LLM_BASE_URL at a provider's *official* endpoint. Third-party relay
# services inject their own system prompt and alias model names, which makes
# cost and behaviour impossible to audit.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=gpt-4o-mini
LLM_TIMEOUT=60

# Capability overrides: auto | true | false.
# "auto" infers from the model id and lets the client downgrade itself at
# runtime when a provider rejects a feature. Pin these only when a provider
# misreports what it supports.
LLM_SUPPORTS_JSON_SCHEMA=auto
LLM_SUPPORTS_TEMPERATURE=auto
LLM_IS_REASONING=auto
LLM_CONTEXT_WINDOW=32000
LLM_MAX_OUTPUT_TOKENS=4096

# Search providers
# fusion = 并行查询多个国内后端并合并结果（同一页面被多个引擎命中会提升排序）
# fallback = 按顺序尝试，直到某个后端返回结果
SEARCH_MODE=fusion
SEARCH_FUSION_BACKENDS=bocha,zhipu,baidu,deepseek,metaso
# 融合全部落空时的兜底后端
SEARCH_API=tavily

# 未配置密钥的后端会被自动跳过（不发请求），只填一个也能工作。
# 博查 AI 搜索：https://bocha.cn
BOCHA_API_KEY=
# 智谱联网搜索：https://bigmodel.cn
ZHIPU_API_KEY=
# 百度千帆 AI 搜索：https://cloud.baidu.com/product/qianfan
BAIDU_API_KEY=
BAIDU_SEARCH_ENDPOINT=https://qianfan.baidubce.com/v2/ai_search/web_search
# DeepSeek 网页搜索（返回 rerank_score / authority / 600-800 字摘要）
DEEPSEEK_API_KEY=
DEEPSEEK_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search
# 秘塔搜索
METASO_API_KEY=
METASO_SEARCH_ENDPOINT=https://metaso.cn/api/v1/search
# Tavily（海外，作为兜底）：https://tavily.com
TAVILY_API_KEY=

SEARCH_RESULT_LIMIT=5
SEARCH_TIMEOUT=15

# Research workflow
MAX_TASKS=4
# 证据不足时额外补检的轮数。0 关闭反思循环；每轮 = 检索 + 抓取 + 总结 + 核查。
MAX_WEB_RESEARCH_LOOPS=1
REFLECTION_MAX_QUERIES=2
# 抓取搜索结果的正文。关闭后只能使用搜索摘要，证据会明显变薄。
FETCH_PAGES=true
FETCH_TIMEOUT=12
FETCH_MAX_SOURCES=4
CHUNKS_PER_SOURCE=2
# 让模型为每条结论打分，确认其引用的来源确实支持该结论。
# 每条任务多一次调用；关闭可换取更低延迟。
VERIFY_CLAIMS=true
VERIFY_MAX_CLAIMS=12
WORKSPACE_DIR=workspace

# 子任务并发数。任务大部分时间在等网络和模型，并发能显著缩短总耗时；设为 1 恢复串行。
TASK_CONCURRENCY=3
