          {
            "text": "[3] 文章指出收到带 id 的消息时，浏览器会把 eventSource.lastEventId 设置为该 id 值。",
            "cited": true,
            "measurable": true,
            "method": "semantic",
            "support": 1.0,
            "supported": true
